---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { PROJECTS } from '../data/site';

// Endereço que aparece na barra da janela de navegador do card
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<section id="projetos" class="sec">
  <div class="wrap">
    <h2 class="disp h2" style="max-width: 13ch">Cinco projetos em produção. <span class="lime">Pode clicar, não quebra.</span></h2>
    <p class="lead">Nada de mockup nem “em breve”: cada case é um site rodando de verdade, com o que eu fiz e as ferramentas que usei.</p>
    <div class="pcards" style={`timeline-scope: ${PROJECTS.map((_, i) => `--pc${i}`).join(', ')}`}>
      {PROJECTS.map((p, i) => (
        <article
          class="pcard"
          data-sink={i < PROJECTS.length - 1 ? '' : undefined}
          style={`top: ${104 + i * 14}px; view-timeline-name: --pc${i}; --next-tl: --pc${i + 1}`}
        >
          <div class="tx">
            <div class="meta pcard-meta"><span>{p.segment}</span><span>{p.year}</span></div>
            <h3 class="disp pcard-title">{p.name}</h3>
            <p class="pcard-desc">{p.description}</p>
            <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
            {p.url && (
              <div class="pcard-cta">
                <Button href={p.url} variant="ghost" icon="external" external>Abrir site</Button>
              </div>
            )}
          </div>
          <div class="im im-shot">
            <div class="browser">
              <div class="browser-bar" aria-hidden="true">
                <span class="browser-dots"><i></i><i></i><i></i></span>
                <span class="browser-url">{p.url ? host(p.url) : 'em breve no ar'}</span>
              </div>
              <Image src={p.image} alt={`Página inicial do projeto ${p.name}`} widths={[600, 900, 1200, 1600]} sizes="(max-width: 900px) 100vw, 55vw" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
