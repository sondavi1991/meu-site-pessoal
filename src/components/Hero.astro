---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import foto from '../assets/davi-manoel.webp';
import { HERO_CODE, SITE } from '../data/site';

// Gera o "papel de parede" de código uma vez, no build.
// Cerca de 24% dos tokens ficam em lima (seed fixa = sempre o mesmo resultado).
const parts = HERO_CODE.repeat(8).match(/[A-Za-z_$]+|[0-9]+|\s+|[^A-Za-z0-9_$\s]+/g) ?? [];
let seed = 7;
const chunks: { s: string; g: boolean }[] = [];
for (const p of parts) {
  seed = (seed * 9301 + 49297) % 233280;
  const g = /\S/.test(p) && seed / 233280 < 0.24;
  const last = chunks[chunks.length - 1];
  if (last && !last.g && !g) last.s += p;
  else chunks.push({ s: p, g });
}

// Título quebrado em palavras para a entrada (cada palavra sobe por trás de uma máscara).
const titleWords = [
  ...'Olá, eu sou o Davi. Engenheiro de software'.split(' ').map((t) => ({ t, lime: false })),
  ...'full stack.'.split(' ').map((t) => ({ t, lime: true })),
];

const commitMsg = 'feat(lp): GA4 + GTM + pixel Meta';
---

<section id="topo" class="hero">
  <div class="wrap hero-in">
    <div class="hero-copy">
      <h1 class="disp hero-title">
        {titleWords.map((w, i) => (
          <>
            <span class:list={['wd', w.lime && 'lime']}><span style={`--i: ${i}`}>{w.t}</span></span>{' '}
          </>
        ))}
      </h1>
      <p class="lead hero-lead">
        Há mais de 10 anos crio sites, landing pages e sistemas sob medida, hoje principalmente com
        Laravel, Node.js e WordPress. Gosto de código limpo, páginas rápidas e de entender o problema
        antes de escrever a primeira linha. Também atuo como gerente de projetos e estou aberto a
        vagas remotas.
      </p>
      <div class="actions">
        <Button href={SITE.cvUrl} icon="download">Baixar CV</Button>
        <Button href={SITE.linkedin} variant="ghost" icon="external" external>Ver LinkedIn</Button>
      </div>
      <p class="meta hero-live">
        No ar agora: <a href="https://scudellerdealmeida.com.br/" target="_blank" rel="noopener">Scudeller de Almeida</a>,
        <a href="https://krooze.com/" target="_blank" rel="noopener">Krooze</a>,
        <a href="https://www.sekiama.com.br/" target="_blank" rel="noopener">Sekiama</a> e mais de 30 sites.
      </p>
    </div>

    <div class="hero-media">
      <div class="hv" data-hero-visual>
        <Image
          src={foto}
          alt="Foto de Davi Manoel"
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 100vw, 52vw"
          loading="eager"
          fetchpriority="high"
        />
        <pre class="code" aria-hidden="true">{chunks.map((c) => (c.g ? <span class="g">{c.s}</span> : c.s))}</pre>
        <div class="commit">
          <div class="commit-top"><span>main</span><span>davi/sitesobmedida</span></div>
          <div class="commit-msg" style={`--n: ${commitMsg.length}`}>
            <span class="typed">{commitMsg}</span><span class="caret" aria-hidden="true"></span>
          </div>
          <div class="commit-ok">eventos testados, no ar</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Revela o código sob o cursor (máscara posicionada em passos de 12px).
  // Na primeira vez que a foto aparece, o código "varre" a foto sozinho (a abertura do hero);
  // no celular é a única chance de ver o efeito, por isso dispara quando a foto entra na tela.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const hv of document.querySelectorAll<HTMLElement>('[data-hero-visual]')) {
    const code = hv.querySelector<HTMLElement>('.code');
    if (!code) continue;
    const snap = (n: number) => Math.round(n / 12) * 12 + 'px';
    const place = (x: number, y: number) => {
      code.style.setProperty('--mx', snap(x));
      code.style.setProperty('--my', snap(y));
    };
    const hide = () => place(-999, -999);
    let userMoved = false;

    hv.addEventListener('mousemove', (e) => {
      userMoved = true;
      const r = hv.getBoundingClientRect();
      place(e.clientX - r.left, e.clientY - r.top);
    });
    hv.addEventListener('mouseleave', hide);

    const sweep = () => {
      const { width: w, height: h } = hv.getBoundingClientRect();
      const duration = 1500;
      const start = performance.now();
      const frame = (now: number) => {
        if (userMoved) return; // o visitante assumiu o controle
        const t = Math.min(1, (now - start) / duration);
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        place(-150 + e * (w + 300), h * 0.4 + Math.sin(e * Math.PI * 2) * h * 0.12);
        if (t < 1) requestAnimationFrame(frame);
        else hide();
      };
      requestAnimationFrame(frame);
    };

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        // 60% da foto visível, ou metade da tela ocupada por ela (telas baixas, celular deitado)
        const enough =
          entry.intersectionRatio >= 0.6 || entry.intersectionRect.height >= innerHeight * 0.5;
        if (!enough) return;
        io.disconnect();
        hv.classList.add('is-in');
        if (!reduce) setTimeout(sweep, 350);
      },
      { threshold: [0, 0.25, 0.5, 0.6, 0.75, 1] },
    );
    io.observe(hv);
  }
</script>
