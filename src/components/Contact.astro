---
import Icon from './Icon.astro';
import { SITE } from '../data/site';

const links = [
  { label: 'Baixar currículo', href: SITE.cvUrl, external: false },
  { label: 'Conversar no LinkedIn', href: SITE.linkedin, external: true },
  { label: 'Site Sob Medida', href: SITE.empresa, external: true },
];
---

<section id="contato" class="sec sec-tight">
  <div class="wrap">
    <h2 class="disp contact-title">Bora fazer um deploy <span class="lime">juntos?</span></h2>
    <p class="lead">Projeto, parceria ou só trocar ideia sobre código: me chama no LinkedIn. O currículo também está aqui.</p>
    <div class="big-links">
      {links.map((l) => (
        <a class="big-link" href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
          <span class="nm">{l.label}</span>
          <span class="ar" aria-hidden="true"><Icon name="arrow" size={22} strokeWidth={1.6} /></span>
        </a>
      ))}
    </div>
  </div>
</section>
