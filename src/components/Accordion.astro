---
import Icon from './Icon.astro';

interface Props {
  title: string;
  titleClass?: string;
  open?: boolean;
}

const { title, titleClass, open = false } = Astro.props;
---

<details class="acc" open={open}>
  <summary>
    <h3 class:list={['ttl', titleClass]}>{title}</h3>
    <span class="pm" aria-hidden="true"><Icon name="plus" size={14} /></span>
  </summary>
  <slot />
</details>
