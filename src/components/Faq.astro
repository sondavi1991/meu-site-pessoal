---
import Accordion from './Accordion.astro';
import { FAQ } from '../data/site';
---

<section class="sec sec-tight">
  <div class="wrap split">
    <div class="faq-intro">
      <h2 class="disp h2" style="max-width: 9ch">README: perguntas <span class="lime">frequentes.</span></h2>
    </div>
    <div class="faq-list">
      {FAQ.map((f) => (
        <Accordion title={f.q} titleClass="faq-q">
          <p class="faq-a">{f.a}</p>
        </Accordion>
      ))}
    </div>
  </div>
</section>
